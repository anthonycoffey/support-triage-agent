{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run eval:validate*)",
      "Bash(npm run eval:selftest)",
      "Bash(npm run eval:diff*)",
      "Bash(npm run eval -- --client oracle*)",
      "Bash(npm run eval -- --client null*)",
      "Bash(npm run eval -- --client constant*)"
    ],
    "ask": [
      "Bash(npm run eval -- --client live*)",
      "Bash(npm run eval:baseline*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./evals/baselines/**)",
      "Edit(./evals/runs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-paths.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-edit-check.mjs\"", "timeout": 120 }]
      }
    ]
  }
}
